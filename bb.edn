;; Task entry points. The design pipeline itself runs on the JVM (`:design`),
;; because garden — the CSS renderer — implements clojure.lang.IFn on its
;; records and will not load under SCI. Babashka is the runner, not the runtime.
{:min-bb-version "1.3.0"
 :tasks
 {tokens {:doc "Generate stylesheets + the cljs token map from tokens.edn"
          :task (shell "clojure" "-M:design")}

  tokens:check {:doc "Fail if the generated artifacts have drifted from tokens.edn"
                :task (shell "clojure" "-M:design" "--check")}

  tokens:report {:doc "Print the contrast table for every pair, scheme and experiment arm"
                 :task (shell "clojure" "-M:design" "--report")}

  ui {:doc "Compile the storefront"
      :task (shell "npx shadow-cljs release app")}

  ui:watch {:doc "Recompile the storefront on save"
            :task (shell "npx shadow-cljs watch app")}

  test {:doc "Run the test suite"
        :task (shell "clojure -M:test")}

  check {:doc "Everything CI runs"
         :depends [tokens:check test]}}}
