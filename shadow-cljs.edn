;; The storefront. Compiled into resources/public/js, which the store's own
;; aleph server serves — so `npx shadow-cljs watch app` and a running `(go)` in
;; the Clojure REPL are the whole fullstack dev loop, on one origin, with no
;; proxy and no second web server.
{:deps {:aliases [:cljs]}
 :nrepl {:port 7931}
 :builds
 {:app {:target :browser
        :output-dir "resources/public/js"
        :asset-path "/js"
        :modules {:main {:init-fn monero-store-ui.core/init}}
        :devtools {:watch-dir "resources/public"}}}}
