{:lib      io.github.buddhilw/monero-store
 :minor    5
 :license  {:name "MIT" :url "https://opensource.org/licenses/MIT"}
 :scm-url  "https://github.com/BuddhiLW/monero-store-template"

 ;; The money path, plus the kontor LEDGER adapter. Every payment-SDK adapter
 ;; (jdbc, monero-rpc, stripe) stays unpublished on its own source root: those
 ;; are for deploying THIS store. The ledger adapter is the one an embedding
 ;; store calls, so it has to be reachable from the coordinate.
 ;;
 ;; This still ships zero vendor jars. kontor is an alias dep, never a
 ;; transitive one, so the namespace only loads for a consumer that put kontor
 ;; on its own classpath — and a consumer that keeps no book never requires it.
 :src-dirs ["src" "resources" "adapters/kontor/src"]

 :publish  :clojars}
