# Copy to .env and edit. Nothing here is a secret until you fill it in — and
# once you do, this file is the one thing in the repo that must never be
# committed. .gitignore already excludes .env.

PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# The operator surface. Unset means there is no operator surface at all.
ADMIN_TOKEN=

# Who is asking. `header` trusts x-customer-ref outright: a demo, or a
# deployment behind a gateway that has already authenticated the caller.
IDENTITY=header

# What is for sale. An EDN vector of items; the sample catalog otherwise.
CATALOG_FILE=catalog.example.edn

# Persistence. `memory` forgets everything on restart — including who paid.
STORE_BACKEND=memory
DATABASE_URL=jdbc:postgresql://postgres:5432/store
DATABASE_USER=store
DATABASE_PASSWORD=

# The chain rail. `fake` needs nothing; `moneropay` watches through a gateway;
# `wallet-rpc` drives a wallet you run yourself (needs the :monero-rpc alias).
MONERO_BACKEND=fake
MONEROPAY_URL=http://moneropay:5000
MONERO_MIN_CONFIRMATIONS=10
# Signs the token in the callback URL. MoneroPay signs nothing itself.
MONERO_CALLBACK_SECRET=
MONERO_WALLET_RPC_URI=
MONERO_WALLET_RPC_USERNAME=
MONERO_WALLET_RPC_PASSWORD=

# The card rail (needs the :stripe alias for `stripe`).
CARDS_BACKEND=none
STRIPE_API_KEY=
# Without this, every Stripe notice is refused and settlement is by polling.
STRIPE_WEBHOOK_SECRET=

RECONCILE_INTERVAL_MS=60000
RATE_CACHE_TTL_MS=60000

# The design contract. Experiments are read from the same file the stylesheets
# are generated from, so an arm that can be assigned has shipped its CSS and
# passed the contrast gate.
TOKENS_FILE=tokens.edn

# Measurement. `umami` posts funnel COUNTS to a self-hosted Umami; the event
# scrubber drops emails, addresses, transaction hashes and customer ids before
# any adapter sees them.
ANALYTICS=none
UMAMI_URL=
UMAMI_WEBSITE_ID=
ANALYTICS_HOSTNAME=store
