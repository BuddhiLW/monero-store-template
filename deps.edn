{;; The core carries NO payment-provider SDK. Every SDK-backed adapter lives on
 ;; its own source root behind its own alias, so a deployment pays only for the
 ;; rails it actually runs.
 :paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.1"}

        ;; malli — value objects, m/=> contract spine, schema-driven tests.
        metosin/malli {:mvn/version "0.20.1"}

        ;; hive-dsl — closed sums with keyword dispatch. defadt generates the
        ;; constructor, the predicate, the exhaustive adt-case AND the ADT's
        ;; malli schema from one declaration, so the sum is stated once.
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.10"}

        ;; reitit + ring + aleph — the http boundary.
        metosin/reitit {:mvn/version "0.10.1"}
        metosin/reitit-ring {:mvn/version "0.10.1"}
        ring/ring-core {:mvn/version "1.14.2"}
        aleph/aleph {:mvn/version "0.9.10"}

        ;; hato — upstream http client (rate tickers, MoneroPay).
        hato/hato {:mvn/version "1.0.0"}

        ;; jsonista — wire encoding.
        metosin/jsonista {:mvn/version "0.3.13"}

        ;; hiccup — the SPA shell is DATA, so the server merges an experiment
        ;; assignment into a map instead of rewriting a document with a regex.
        hiccup/hiccup {:mvn/version "2.0.0-RC5"}

        ;; timbre — logging.
        com.taoensso/timbre {:mvn/version "6.6.1"}}

 :aliases
 {;; ------------------------------------------------------------------ rails
  ;; monero-wallet-rpc: the store runs its own wallet.
  :monero-rpc {:extra-paths ["adapters/monero-rpc/src"]
               :extra-deps {io.github.woodser/monero-java {:mvn/version "0.8.50"}}}

  ;; stripe: hosted card checkout.
  :stripe {:extra-paths ["adapters/stripe/src"]
           :extra-deps {com.stripe/stripe-java {:mvn/version "33.2.0"}}}

  ;; postgres-backed order store.
  :jdbc {:extra-paths ["adapters/jdbc/src"]
         :extra-deps {com.github.seancorfield/next.jdbc {:mvn/version "1.3.1002"}
                      org.postgresql/postgresql {:mvn/version "42.7.7"}
                      com.zaxxer/HikariCP {:mvn/version "6.3.0"}}}

  ;; ------------------------------------------------------------------ design
  ;; The stylesheet pipeline is design-forge; this project owns only the
  ;; contract (tokens.edn), the rules (design/theme.clj) and design-forge.edn.
  ;;
  ;; design-forge is not on Clojars yet, so this names its GIT coordinate: a
  ;; cold clone of this repo builds its own stylesheets with no local checkout
  ;; and no untracked override file. Nothing under src/ requires it — `system`
  ;; resolves the token reader lazily — so a cold `clojure -M:test` never
  ;; fetches it at all.
  :design {:extra-paths ["src"]
           :extra-deps {io.github.buddhilw/design-forge
                        {:git/url "https://github.com/BuddhiLW/design-forge"
                         :git/sha "03809ec31fe9a36cf831dfae526e43d15b5a53d5"}}
           :main-opts ["-m" "design-forge.main"]}

  ;; ------------------------------------------------------------------ ui
  ;; The storefront. Kept out of :dev so a backend-only deployment never
  ;; resolves a ClojureScript toolchain it does not run.
  :cljs {:extra-paths ["ui/src"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "3.4.0"}
                      reagent/reagent {:mvn/version "1.3.0"}}}

  ;; ------------------------------------------------------------------ dev
  :dev {:extra-paths ["dev" "test" "ui/src"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                     org.clojure/tools.namespace {:mvn/version "1.5.0"}
                     nrepl/nrepl {:mvn/version "1.3.1"}}}

  ;; The suite is schema-driven: hive-schemas synthesizes the property,
  ;; contract and mutation facets from the malli schemas the code already
  ;; carries, and hive-test supplies the mutation engine underneath.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.1.11"}
                      io.github.hive-agi/hive-test {:mvn/version "0.3.11"}}
         ;; ^:integration is EXCLUDED here. Those tests probe real daemons from
         ;; docker-compose.integration.yml, and a cold clone with no container
         ;; runtime must still go green.
         :main-opts ["-m" "cognitect.test-runner" "-e" "integration"]
         :exec-fn cognitect.test-runner.api/test}

  ;; The other half: ONLY the daemon tests. Layers over :test for paths and
  ;; deps, overriding its main-opts — `clojure -M:test:test-integration`.
  :test-integration {:main-opts ["-m" "cognitect.test-runner" "-i" "integration"]}

  :nrepl {:extra-paths ["dev" "test" "ui/src"]
          :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                       org.clojure/tools.namespace {:mvn/version "1.5.0"}
                       nrepl/nrepl {:mvn/version "1.3.1"}
                       cider/cider-nrepl {:mvn/version "0.50.2"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"
                      "--port" "7930"]}

  ;; ----------------------------------------------------------------- release
  ;; The APPLICATION artifact: one deployable process, carrying the rails its
  ;; :aliases name. `clojure -T:uberjar uber :aliases '[:stripe :jdbc]'`.
  :uberjar {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}}
            :ns-default build}

  ;; The LIBRARY artifact: this store's money path, for a project that wants
  ;; to embed it rather than reimplement it. Coordinates come from
  ;; ./version.edn, the version from ./VERSION, and the task names are the
  ;; fleet's — `clean jar install bump deploy` mean here what they mean in
  ;; every other hive package.
  ;;
  ;;   clojure -T:build install     -> ~/.m2, for a consumer to resolve
  ;;
  ;; A SOURCE jar, deliberately: the protocols in payments.provider and
  ;; collect.* are what a consumer implements, and an AOT'd record compiled
  ;; against a source-shipped protocol fails to link at the consumer's loader.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.10"}}
          :ns-default hive-build.api}
  :arch {:extra-deps {org.soulspace.clj/overarch {:mvn/version "0.41.0"}}
                 :main-opts ["-m" "org.soulspace.overarch.adapter.ui.cli"]}}
 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}}
