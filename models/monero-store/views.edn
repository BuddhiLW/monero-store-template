  ;;; ---------------------------------------------------------- C3 components

  {:el :component-view
   :id :monero-store/rails-view
   :title "Components — the payment rails"
   :desc "The DIP seam. A rail is an IPaymentRail plus a ProviderProfile in a registry; settle reads the profile and never branches on which rail it is, so adding a rail edits nothing here."
   :ct [{:ref :monero-store/rail-registry}
        {:ref :monero-store/settle-decision}
        {:ref :monero-store/chain-rail}
        {:ref :monero-store/hosted-rail}
        {:ref :monero-store/manual-rail}
        {:ref :monero-store/stripe-reader}
        {:ref :monero-store/i-chain-wallet}
        {:ref :monero-store/i-card-gateway}

        {:ref :monero-store/registry-holds-chain :direction :down}
        {:ref :monero-store/registry-holds-hosted :direction :down}
        {:ref :monero-store/registry-holds-manual :direction :down}
        {:ref :monero-store/settle-reads-registry :direction :right}
        {:ref :monero-store/hosted-reads-stripe}
