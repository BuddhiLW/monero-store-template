        {:ref :monero-store/payments}
        {:ref :monero-store/promote}
        {:ref :monero-store/collect}
        {:ref :monero-store/order-store}

        {:ref :monero-store/storefront-calls-boundary :direction :down}
        {:ref :monero-store/boundary-drives-pipeline :direction :down}
